NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/roomora
# Optional in development (D17), required in production
REDIS_URL=
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32 random bytes, base64. AES-256-GCM for ID numbers and Razorpay secrets
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# OTP is always 123456 and logged. Rejected when NODE_ENV=production (D14)
OTP_DEV_MODE=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID_OTP=
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Roomora's own subscription billing only. Rent uses each org's keys (D1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
